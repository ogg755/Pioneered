+void RateControl::updateJogFilter(int iSamplesPerBuffer) {
+    // Pioneered: keep the jog smoothing window a fixed length of time and the
+    // nudge displacement independent of the audio buffer size. Only recompute
+    // when the buffer size actually changes -- this runs in the engine
+    // callback, and Rotary::setFilterLength() merely clamps an index bound
+    // (the buffer is allocated at its maximum in the constructor), so there is
+    // no allocation on this path.
+    if (iSamplesPerBuffer == m_jogFilterSamplesPerBuffer) {
+        return;
+    }
+    m_jogFilterSamplesPerBuffer = iSamplesPerBuffer;
+
+    const double sampleRate = m_pSampleRate ? m_pSampleRate->get() : 0.0;
+    const int framesPerBuffer = iSamplesPerBuffer / mixxx::kEngineChannelCount;
+    if (sampleRate <= 0.0 || framesPerBuffer <= 0) {
+        // Nothing sensible to derive from yet; keep the stock behaviour.
+        m_pJogFilter->setFilterLength(kJogFilterMaxLength);
+        m_jogSensitivityScale = 1.0;
+        return;
+    }
+
+    const double bufferSeconds = framesPerBuffer / sampleRate;
+    const int filterLength = math_clamp(
+            static_cast<int>(std::lround(kJogFilterWindowSeconds / bufferSeconds)),
+            1,
+            kJogFilterMaxLength);
+    m_pJogFilter->setFilterLength(filterLength);
+    m_jogSensitivityScale = math_clamp(kJogReferenceBufferSeconds / bufferSeconds,
+            kJogSensitivityScaleMin,
+            kJogSensitivityScaleMax);
+}
