+// Pioneered: the jog (pitch bend) smoothing window used to be a fixed *number
+// of audio buffers* (25), so its length in real time was whatever the audio
+// buffer setting happened to be -- ~125 ms on a 5 ms desktop buffer, but well
+// over half a second on the Pi's much larger buffer. Since Rotary::filter() is
+// a plain moving average, the nudge also kept being applied for that entire
+// window after the hand stopped moving, which made beatmatching by ear a
+// guessing game: nudge, wait, overshoot, correct back.
+//
+// The window is now a fixed length of time instead, so the nudge follows the
+// hand and stops when the hand stops, whatever the audio buffer is set to.
+constexpr double kJogFilterWindowSeconds = 0.06;
+constexpr int kJogFilterMaxLength = 25;
+
+// Pioneered: the *displacement* a nudge produces is jog * sensitivity * buffer
+// duration, so it scaled with the audio buffer setting too -- a bigger buffer
+// shoved the track further per detent. Normalise it against a reference buffer
+// so the feel no longer depends on the latency setting, leaving bendScale in
+// the controller mapping as the single sensitivity knob. The reference is a
+// 1024-frame buffer at 44.1 kHz, the stock behaviour it is matched to.
+constexpr double kJogReferenceBufferSeconds = 1024.0 / 44100.0;
+// Bound the correction so an unusual buffer size cannot swing the feel wildly.
+constexpr double kJogSensitivityScaleMin = 0.5;
+constexpr double kJogSensitivityScaleMax = 2.0;
 } // namespace
 
