+// XDJ: last physical tempo fader position per deck (as a Mixxx "rate"
+// value). Populated by the startup position query SysEx reply and by every
+// fader movement; applied to the deck when a new track is loaded.
+PioneerDDJ400.lastTempoSliderValue = {
+    "[Channel1]": null,
+    "[Channel2]": null
+};
+
+PioneerDDJ400.tempoSliderSyncOnLoad = function(value, group) {
+    if (value !== 1) {
+        return;
+    }
+    // Wait out Mixxx's own speed/pitch reset on track load (it runs on the
+    // main thread shortly after track_loaded flips), then jump the tempo to
+    // the physical fader position. Soft takeover resumes afterwards with the
+    // internal value matching the fader, so there is no dead zone.
+    engine.beginTimer(200, function() {
+        const rate = PioneerDDJ400.lastTempoSliderValue[group];
+        if (rate === null) {
+            return;
+        }
+        engine.softTakeoverIgnoreNextValue(group, "rate");
+        engine.setValue(group, "rate", rate);
+    }, true);
+};
+
