+void ControllerManager::slotCheckDisconnectedDevices() {
+    // XDJ reconnect watchdog. Two triggers:
+    //  1. An open controller reports a run of I/O errors (USB unplugged or
+    //     power-cycled) -> rescan and reopen.
+    //  2. A device that is enabled in the config is not present/open (plugged
+    //     in after startup, or replugged after 1 closed it) -> rescan until
+    //     it comes back. Disable the controller in the preferences to stop
+    //     the periodic rescan.
+    auto locker = lockMutex(&m_mutex);
+    if (m_enumerators.isEmpty()) {
+        return;
+    }
+    const QList<Controller*> controllers = m_controllers;
+    locker.unlock();
+
+    bool needSetup = false;
+    QSet<QString> openDevices;
+    for (Controller* pController : controllers) {
+        if (pController->isOpen()) {
+            if (pController->seemsDisconnected()) {
+                qWarning() << "Controller" << pController->getName()
+                           << "seems disconnected, reconnecting";
+                needSetup = true;
+            } else {
+                openDevices.insert(sanitizeDeviceName(pController->getName()));
+            }
+        }
+    }
+
+    if (!needSetup) {
+        const QList<ConfigKey> controllerKeys =
+                m_pConfig->getKeysWithGroup(QStringLiteral("[Controller]"));
+        for (const ConfigKey& key : controllerKeys) {
+            if (m_pConfig->getValue(key, 0) &&
+                    !getConfiguredMappingFileForDevice(key.item).isEmpty() &&
+                    !openDevices.contains(key.item)) {
+                qDebug() << "Enabled controller" << key.item
+                         << "not open, rescanning";
+                needSetup = true;
+                break;
+            }
+        }
+    }
+
+    if (needSetup) {
+        slotSetUpDevices();
+    }
+}
+
 void ControllerManager::pollIfAnyControllersOpen() {
     auto locker = lockMutex(&m_mutex);
     QList<Controller*> controllers = m_controllers;
