 #endif
 
 namespace {
+/// XDJ reconnect watchdog pacing. Responsive interval first, so a replug is
+/// picked up quickly, then exponential backoff up to the ceiling so a
+/// permanently absent controller stops driving endless USB/MIDI enumerations.
+constexpr int kReconnectIntervalMs = 5000;
+constexpr int kReconnectMaxIntervalMs = 60000;
+constexpr int kReconnectFastAttempts = 3;
+
 /// Strip slashes and spaces from device name, so that it can be used as config
 /// key or a filename.
 QString sanitizeDeviceName(QString name) {
@@ -109,7 +118,7 @@ ControllerManager::ControllerManager(UserSettingsPointer pConfig)
     connect(&m_pollTimer, &QTimer::timeout, this, &ControllerManager::pollDevices);
 
     // XDJ reconnect watchdog (see slotCheckDisconnectedDevices).
-    m_reconnectTimer.setInterval(5000);
+    m_reconnectTimer.setInterval(kReconnectIntervalMs);
     connect(&m_reconnectTimer,
             &QTimer::timeout,
             this,
@@ -362,8 +371,35 @@ void ControllerManager::slotCheckDisconnectedDevices() {
         }
     }
 
-    if (needSetup) {
-        slotSetUpDevices();
+    if (!needSetup) {
+        // Everything enabled is open: back to the responsive interval so the
+        // next unplug is noticed within 5 s.
+        m_reconnectMisses = 0;
+        if (m_reconnectTimer.interval() != kReconnectIntervalMs) {
+            m_reconnectTimer.setInterval(kReconnectIntervalMs);
+        }
+        return;
+    }
+
+    // slotSetUpDevices() is a full PortMidi + HID enumeration. A controller
+    // that is enabled in the preferences but simply not plugged in leaves
+    // needSetup true forever, so at a flat 5 s this rescanned indefinitely --
+    // a recurring hitch and constant background CPU on a Pi for a device that
+    // is never coming back.
+    //
+    // The first few attempts stay at 5 s, so replugging still reconnects
+    // promptly (the documented behaviour); after that the interval doubles up
+    // to a 60 s ceiling. Any successful open resets it above.
+    slotSetUpDevices();
+
+    if (++m_reconnectMisses > kReconnectFastAttempts) {
+        const int backoff = std::min(
+                m_reconnectTimer.interval() * 2, kReconnectMaxIntervalMs);
+        if (backoff != m_reconnectTimer.interval()) {
+            m_reconnectTimer.setInterval(backoff);
+            qDebug() << "Controller reconnect watchdog backing off to"
+                     << backoff << "ms";
+        }
     }
 }
 
