@@ -227,9 +227,16 @@ void rekordbox_pdb_t::page_t::_read() {
     m_next_page = std::unique_ptr<page_ref_t>(new page_ref_t(m__io, this, m__root));
     m__unnamed4 = m__io->read_u4le();
     m__unnamed5 = m__io->read_bytes(4);
-    m_num_rows_small = m__io->read_u1();
-    m__unnamed7 = m__io->read_u1();
-    m__unnamed8 = m__io->read_u1();
+    // These 3 bytes are really a 13-bit row count plus an 11-bit
+    // "rows valid" count (little-endian bit order), not the old
+    // num_rows_small/num_rows_large heuristic, which undercounted rows
+    // on pages with many small rows (playlist entries, tracks) and
+    // silently dropped their contents. Backport of upstream 2144bf9075
+    // (PR #15745, fix/rekordbox-missing-table-rows).
+    m_num_rows = static_cast<uint16_t>(m__io->read_bits_int_le(13));
+    m_num_rows_valid = static_cast<uint16_t>(m__io->read_bits_int_le(11));
+    m__io->align_to_byte();
+    f_num_rows = true;
     m_page_flags = m__io->read_u1();
     m_free_size = m__io->read_u2le();
     m_used_size = m__io->read_u2le();
@@ -256,10 +263,8 @@ void rekordbox_pdb_t::page_t::_clean_up() {
 }
 
 uint16_t rekordbox_pdb_t::page_t::num_rows() {
