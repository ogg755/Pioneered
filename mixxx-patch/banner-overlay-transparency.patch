+    // Pioneered: pure-display widgets (popup banners) can opt out of mouse
+    // hit-testing entirely. Without this, a banner overlay appearing above
+    // a pressed button sends the button a Leave event, and WPushButton
+    // fakes a mouse release on Leave — cancelling e.g. an eject hold.
+    if (m_pContext->selectBool(node, "TransparentForMouseEvents", false)) {
