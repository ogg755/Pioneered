+void LibraryControl::slotRestartHold(int deck, double v) {
+    if (v > 0) {
+        if (m_restartHoldDeck != 0 || m_restartTriggered) {
+            return; // one hold at a time; nothing more once the restart fired
+        }
+        m_restartHoldDeck = deck;
+        m_restartFlashOn = false;
+        m_lastRestartFlashToggleMs = 0;
+        m_restartElapsed.start();
+        m_restartFlashTimer.start();
+        return;
+    }
+    if (m_restartHoldDeck != deck) {
+        return; // restart already fired at 7s, or stray release
+    }
+    // Released early: cancel. The track load itself happened on press via
+    // the button's LoadSelectedTrack connection, untouched by this gesture.
+    m_restartFlashTimer.stop();
+    m_restartHoldDeck = 0;
+    m_restartFlashOn = false;
+    updateLoadFlashControls();
+}
+
+void LibraryControl::slotRestartFlashTick() {
+    if (m_restartHoldDeck == 0) {
+        m_restartFlashTimer.stop();
+        return;
+    }
+    const qint64 elapsed = m_restartElapsed.elapsed();
+    if (elapsed >= 7000) {
+        m_restartFlashTimer.stop();
+        m_restartHoldDeck = 0;
+        m_restartFlashOn = false;
+        updateLoadFlashControls();
+        triggerRestart();
+        return;
+    }
+    if (elapsed < 600) {
+        return; // ordinary load taps must not flicker
+    }
+    // Flash toggle interval shrinks linearly 250ms -> 80ms over the hold,
+    // the same feel as the USB eject hold.
+    const qint64 interval = qMax<qint64>(80,
+            250 - (250 - 80) * (elapsed - 600) / (7000 - 600));
+    if (m_lastRestartFlashToggleMs == 0 ||
+            elapsed - m_lastRestartFlashToggleMs >= interval) {
+        m_restartFlashOn = !m_restartFlashOn;
+        m_lastRestartFlashToggleMs = elapsed;
+        updateLoadFlashControls();
+    }
+}
+
+void LibraryControl::updateLoadFlashControls() {
+    m_pLoadFlash1->setAndConfirm(
+            (m_restartHoldDeck == 1 && m_restartFlashOn) ? 1.0 : 0.0);
+    m_pLoadFlash2->setAndConfirm(
+            (m_restartHoldDeck == 2 && m_restartFlashOn) ? 1.0 : 0.0);
+}
+
+void LibraryControl::triggerRestart() {
+    if (m_restartTriggered) {
+        return;
+    }
+    m_restartTriggered = true;
+    showBanner(m_pRestarting.get());
+    // Relaunch with the same binary and arguments this instance was started
+    // with, single-quoted for the shell.
+    QStringList parts = QCoreApplication::arguments();
+    if (!parts.isEmpty()) {
+        parts[0] = QCoreApplication::applicationFilePath();
+    } else {
+        parts << QStringLiteral("mixxx");
+    }
+    QStringList quoted;
+    for (const QString& part : std::as_const(parts)) {
+        quoted << QChar('\'') +
+                        QString(part).replace(QChar('\''),
+                                QStringLiteral("'\\''")) +
+                        QChar('\'');
+    }
+    // The helper is startDetached'ed into its own session, so it survives
+    // the killall it performs. SIGTERM first for a clean shutdown (library
+    // DB flush); SIGKILL only if Mixxx is still up after 10s — a truly
+    // wedged instance won't honour TERM.
+    const QString script = QStringLiteral(
+            "sleep 1; killall mixxx; "
+            "n=0; while [ $n -lt 40 ] && pgrep -x mixxx >/dev/null; do "
+            "sleep 0.25; n=$((n+1)); done; "
+            "if pgrep -x mixxx >/dev/null; then killall -9 mixxx; sleep 1; fi; "
+            "[ -n \"$DISPLAY\" ] || export DISPLAY=:0; "
+            "exec ") +
+            quoted.join(QChar(' '));
+    qWarning() << "Hold-to-restart: killing and relaunching Mixxx:" << script;
+    QProcess::startDetached(QStringLiteral("/bin/sh"),
+            QStringList() << QStringLiteral("-c") << script);
+}
