+            // 1..size via QMap::operator[], which is only correct when
+            // entry_index is exactly the contiguous set {1..N}. Real rekordbox
+            // exports use sparse / non-1-based entry_index values, so that
+            // lookup scrambled the order (trailing tracks surfacing at the top
+            // of the playlist) and silently inserted phantom track_id=0 rows
+            // for every missing key.
+            int trackIndex = 0;
+            const QMap<uint32_t, uint32_t>& playlistEntries =
+                    playlistTrackMap[childID];
+            for (auto it = playlistEntries.constBegin();
+                    it != playlistEntries.constEnd();
+                    ++it) {
+                trackIndex++;
+                uint32_t rbTrackID = it.value();

                 int trackID = -1;
