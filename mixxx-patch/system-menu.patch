+void LibraryControl::slotMenuPower(double v) {
+    if (v <= 0.0) {
+        return; // arm/commit on press; the release is just the button reset
+    }
+    if (m_pArmPower->get() > 0.0) {
+        disarmSystemMenu();
+        triggerPowerOff();
+        return;
+    }
+    disarmSystemMenu(); // arming one option cancels the other
+    m_pArmPower->setAndConfirm(1.0);
+    m_disarmTimer.start();
+}
+
+void LibraryControl::slotMenuRestart(double v) {
+    if (v <= 0.0) {
+        return;
+    }
+    if (m_pArmRestart->get() > 0.0) {
+        disarmSystemMenu();
+        triggerRestart();
+        return;
+    }
+    disarmSystemMenu();
+    m_pArmRestart->setAndConfirm(1.0);
+    m_disarmTimer.start();
+}
+
+void LibraryControl::disarmSystemMenu() {
+    m_disarmTimer.stop();
+    m_pArmPower->setAndConfirm(0.0);
+    m_pArmRestart->setAndConfirm(0.0);
+}
+
+void LibraryControl::triggerPowerOff() {
+    if (m_powerOffTriggered) {
+        return;
+    }
+    m_powerOffTriggered = true;
+    showBanner(m_pPoweringOff.get());
+    // logind/polkit normally lets the local session power off with no sudo
+    // rule at all; fall back to the same passwordless sudo the USB eject
+    // already relies on, for setups where it does not (no seat, no polkit
+    // agent). systemctl returns as soon as the job is queued, so a 0 exit
+    // means "shutdown accepted", not "shutdown finished".
+    const QString script = QStringLiteral(
+            "systemctl poweroff || sudo -n poweroff || "
+            "sudo -n shutdown -h now");
+    qWarning() << "Settings menu: powering off:" << script;
+    auto* pProcess = new QProcess(this);
+    connect(pProcess,
+            QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this,
+            [this, pProcess](int exitCode, QProcess::ExitStatus exitStatus) {
+                pProcess->deleteLater();
+                if (exitStatus == QProcess::NormalExit && exitCode == 0) {
+                    return; // shutdown under way; the banner rides it out
+                }
+                const QString errorOutput = QString::fromUtf8(
+                        pProcess->readAllStandardError())
+                                                    .trimmed();
+                qWarning() << "poweroff failed:" << errorOutput;
+                // Every route refused: re-arm so the operator can retry,
+                // and say so rather than leaving them tapping a dead button.
+                m_powerOffTriggered = false;
+                showBanner(m_pPowerOffFailed.get());
+            });
+    connect(pProcess,
+            &QProcess::errorOccurred,
+            this,
+            [this, pProcess](QProcess::ProcessError error) {
+                // finished() never fires for a process that failed to start;
+                // without this the menu would sit on POWERING OFF forever
+                if (error == QProcess::FailedToStart) {
+                    pProcess->deleteLater();
+                    m_powerOffTriggered = false;
+                    showBanner(m_pPowerOffFailed.get());
+                }
+            });
+    pProcess->start(QStringLiteral("/bin/sh"),
+            {QStringLiteral("-c"), script});
+}
