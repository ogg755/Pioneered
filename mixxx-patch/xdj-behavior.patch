diff --git a/src/effects/backends/builtin/filtereffect.cpp b/src/effects/backends/builtin/filtereffect.cpp
--- a/src/effects/backends/builtin/filtereffect.cpp
+++ b/src/effects/backends/builtin/filtereffect.cpp
@@ -8,6 +8,38 @@
 namespace {
 constexpr double kMinCorner = 13;    // Hz
 constexpr double kMaxCorner = 22050; // Hz
+
+// Pioneered: reshape the knob-to-cutoff curve to feel like Pioneer hardware.
+// Stock Mixxx sweeps the full ~10.7 octaves linearly-in-log across the knob,
+// so a small turn already removes most of the musical content. The gamma
+// curve below creates a plateau near the neutral position and compresses the
+// aggressive cutting into the outer part of the throw:
+//   LPF at 20% turn ~14.7 kHz (barely audible), 50% ~2.6 kHz, 100% full cut.
+// Applies to whatever drives the lpf/hpf parameters (deck filter super knob
+// as well as the effect rack knobs).
+constexpr double kCurveGamma = 1.8;
+
+double shapeLpf(double lpf) {
+    if (lpf >= kMaxCorner) {
+        // exact corner value so the neutral-position bypass check still fires
+        return kMaxCorner;
+    }
+    double x = std::log(lpf / kMinCorner) / std::log(kMaxCorner / kMinCorner);
+    x = math_clamp(x, 0.0, 1.0); // x = 1 neutral, x = 0 full cut
+    const double y = 1.0 - std::pow(1.0 - x, kCurveGamma);
+    return kMinCorner * std::pow(kMaxCorner / kMinCorner, y);
+}
+
+double shapeHpf(double hpf) {
+    if (hpf <= kMinCorner) {
+        // exact corner value so the neutral-position bypass check still fires
+        return kMinCorner;
+    }
+    double x = std::log(hpf / kMinCorner) / std::log(kMaxCorner / kMinCorner);
+    x = math_clamp(x, 0.0, 1.0); // x = 0 neutral, x = 1 full cut
+    const double y = std::pow(x, kCurveGamma);
+    return kMinCorner * std::pow(kMaxCorner / kMinCorner, y);
+}
 } // anonymous namespace
 
 // static
