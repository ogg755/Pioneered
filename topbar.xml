<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,50f</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>TabControls</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <!-- Fixed left counterweight, exactly the cog's footprint (56f
               button + its 8px right margin). Without it the only slack in
               the strip sat on the right, so the three tabs were pushed left
               of centre.

               Deliberately fixed rather than expanding: an expanding spacer
               competes with the tabs for surplus on equal terms, so on the
               Pi's 800px screen five equal claimants would leave the tabs at
               ~147px with ~294px wasted on spacers. Fixed at both ends, the
               tabs split every remaining pixel three ways — identical
               widths, and the strip is symmetric at any window size. -->
          <WidgetGroup>
            <ObjectName>TabSpacer</ObjectName>
            <Layout>horizontal</Layout>
            <Size>64f,0me</Size>
          </WidgetGroup>
          <Template src="skin:tab.xml">
            <SetVariable name="tab_name">Overview</SetVariable>
            <SetVariable name="config_key">overview</SetVariable>
          </Template>
          <Template src="skin:tab.xml">
            <SetVariable name="tab_name">Browse</SetVariable>
            <SetVariable name="config_key">library</SetVariable>
          </Template>
          <Template src="skin:tab.xml">
            <SetVariable name="tab_name">Search</SetVariable>
            <SetVariable name="config_key">search</SetVariable>
          </Template>
          <!-- No right spacer: the tabs expand to fill, which pins the cog to
               the right corner on its own. A spacer here would only take
               width away from the tabs. -->
          <PushButton>
            <ObjectName>SettingsCog</ObjectName>
            <Size>56f,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>&#9881;</Text></State>
            <State><Number>1</Number><Text>&#9881;</Text></State>
            <Connection>
              <ConfigKey persist="false">[Skin],show_settings</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <!-- Closing (or reopening) the panel clears any armed confirm. -->
            <Connection>
              <ConfigKey persist="false">[Library],menu_disarm</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
